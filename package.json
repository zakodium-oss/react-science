{
  "name": "react-science",
  "version": "24.0.0",
  "description": "React components to build scientific applications UI",
  "type": "module",
  "exports": {
    "./ui": "./lib/components/index.js",
    "./styles/*.css": "./styles/*.css"
  },
  "files": [
    "lib",
    "src/components",
    "styles/preflight.css"
  ],
  "scripts": {
    "build": "npm run clean && npm run build-ts",
    "build-all": "npm run build-app && npm run build-storybook && mv storybook-static dist/stories",
    "build-app": "cross-env NO_MINIFY=true vite build",
    "build-storybook": "storybook build",
    "build-ts": "tsc -p tsconfig.build.json",
    "check-types": "tsc --noEmit",
    "clean": "rimraf lib",
    "createData": "npm run prepack && node scripts/createData",
    "dev": "echo Use npm run dev-app or npm run storybook && exit 1",
    "dev-app": "vite --open /pages/demo.html",
    "eslint": "eslint . --cache --max-warnings=51",
    "eslint-fix": "npm run eslint -- --fix",
    "playwright": "npm run playwright-ct -- --project chromium && npm run playwright-e2e -- --project chromium",
    "playwright-ct": "playwright test -c playwright-ct.config.mts",
    "playwright-e2e": "playwright test -c playwright-e2e.config.mts",
    "prepack": "npm run build",
    "prettier": "prettier --check .",
    "prettier-write": "prettier --write .",
    "serve": "vite preview",
    "storybook": "storybook dev -p 6006",
    "stylelint": "stylelint src stories styles",
    "stylelint-fix": "npm run stylelint -- --fix",
    "test": "npm run playwright && npm run test-only && npm run check-types && npm run stylelint && npm run eslint && npm run prettier",
    "test-only": "vitest run --coverage "
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zakodium-oss/react-science.git"
  },
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/zakodium-oss/react-science/issues"
  },
  "homepage": "https://github.com/zakodium-oss/react-science#readme",
  "peerDependencies": {
    "@blueprintjs/core": "^6.20.0",
    "@blueprintjs/icons": "^6.14.1",
    "@blueprintjs/select": "^6.3.6",
    "fifo-logger": "^2.0.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "dependencies": {
    "@emotion/styled": "^11.14.1",
    "@radix-ui/react-use-controllable-state": "^1.2.6",
    "@tanstack/react-form": "^1.33.5",
    "@tanstack/react-store": "^0.11.1",
    "@tanstack/react-table": "^9.2.4",
    "@tanstack/react-virtual": "^3.14.13",
    "@zakodium/pdnd-esm": "^1.1.2",
    "@zakodium/utils": "^0.5.1",
    "d3-scale-chromatic": "^3.1.0",
    "react-d3-utils": "^3.1.2",
    "react-dropzone": "^20.1.2",
    "react-full-screen": "^1.1.1",
    "react-icons": "^5.7.0",
    "react-inspector": "^9.0.0",
    "tinycolor2": "^1.6.0",
    "ts-pattern": "^5.9.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@blueprintjs/core": "6.20.0",
    "@blueprintjs/icons": "6.14.1",
    "@blueprintjs/select": "6.3.6",
    "@floating-ui/react": "^0.27.20",
    "@playwright/experimental-ct-react": "1.62.1",
    "@playwright/test": "1.62.1",
    "@storybook/addon-docs": "^10.6.0",
    "@storybook/react-vite": "^10.6.0",
    "@tanstack/react-query": "^5.103.2",
    "@types/babel__core": "^7.20.5",
    "@types/d3-scale-chromatic": "^3.1.0",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/tinycolor2": "^1.4.6",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^5.0.1",
    "@zakodium/tsconfig": "^1.0.5",
    "biologic-converter": "^1.0.0",
    "cheminfo-font": "^1.28.0",
    "cheminfo-types": "^1.16.0",
    "cross-env": "^10.1.0",
    "eslint": "^10.11.0",
    "eslint-config-zakodium": "^21.0.0",
    "eslint-plugin-storybook": "^10.6.0",
    "fifo-logger": "2.0.1",
    "filelist-utils": "^1.11.3",
    "immer": "^11.1.18",
    "jcampconverter": "^12.5.7",
    "ml-gsd": "^14.3.0",
    "ml-peak-shape-generator": "^5.6.0",
    "ml-signal-processing": "^2.2.2",
    "ml-spectra-processing": "^14.35.1",
    "ms-spectrum": "^3.12.1",
    "netcdfjs": "^4.0.0",
    "postcss-styled-syntax": "^0.7.2",
    "prettier": "^3.9.9",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-error-boundary": "^6.1.6",
    "react-kbs": "^3.1.0",
    "react-ocl": "^8.7.2",
    "react-plot": "^3.1.2",
    "rimraf": "^6.1.3",
    "spc-parser": "^2.1.1",
    "storybook": "^10.6.0",
    "stylelint": "^17.15.0",
    "stylelint-config-standard": "^40.0.0",
    "typescript": "^6.0.3",
    "vite": "^8.3.0",
    "vitest": "^5.0.1",
    "wdf-parser": "^1.0.0"
  },
  "volta": {
    "node": "24.21.0"
  }
}
